{
  "id": "com.draper.homey-docs",
  "version": "1.0.8",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Homey Docs Companion"
  },
  "description": {
    "en": "Cross-reference viewer and AI assistant integration for Homey Pro."
  },
  "category": "tools",
  "permissions": [
    "homey:manager:api"
  ],
  "images": {
    "small": "./assets/images/small.png",
    "large": "./assets/images/large.png"
  },
  "author": {
    "name": "Jonathan Draper"
  },
  "source": "https://github.com/jmdraper/homey-docs",
  "brandColor": "#2d6cdf",
  "flow": {
    "actions": [
      {
        "id": "regenerate_xref",
        "title": {
          "en": "Update cross-reference index"
        },
        "hint": {
          "en": "Rebuilds the cross-reference viewer showing which flows use each variable, FlowBits event, timer, and label. The viewer is accessible at http://[homey-ip]:8734/ on your local network."
        }
      }
    ]
  },
  "api": {
    "snapshot": {
      "method": "GET",
      "path": "/snapshot"
    },
    "flows_metadata": {
      "method": "GET",
      "path": "/flows_metadata"
    },
    "variables": {
      "method": "GET",
      "path": "/variables"
    },
    "devices": {
      "method": "GET",
      "path": "/devices"
    },
    "apps": {
      "method": "GET",
      "path": "/apps"
    },
    "zones": {
      "method": "GET",
      "path": "/zones"
    },
    "reset_snapshot": {
      "method": "DELETE",
      "path": "/reset_snapshot"
    },
    "diagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    },
    "rejections": {
      "method": "GET",
      "path": "/rejections"
    },
    "refresh": {
      "method": "POST",
      "path": "/refresh"
    },
    "flow_summary": {
      "method": "GET",
      "path": "/flow_summary"
    },
    "search_flows": {
      "method": "GET",
      "path": "/search_flows"
    },
    "app_actions": {
      "method": "GET",
      "path": "/app_actions"
    },
    "cross_references": {
      "method": "GET",
      "path": "/cross_references",
      "public": true
    }
  }
}